; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodAmp"
config/description="Modern Winamp Clone. Submission for https://itch.io/jam/the-tool-jam-5."
config/tags=PackedStringArray("music", "tool")
run/main_scene="uid://db6b3hi4hou7w"
run/low_processor_mode=false
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.141176, 0.141176, 0.141176, 0)
boot_splash/show_image=false
config/icon="uid://c0s3kbvufqavr"

[audio]

buses/default_bus_layout="res://DefaultBusLayout.tres"

[autoload]

SignalBus="*res://Src/Autoload/SignalBus.cs"
SettingsManager="*res://Src/Autoload/SettingsManager.cs"
SkinLoader="*res://Src/Autoload/SkinLoader.cs"

[display]

window/size/viewport_width=275
window/size/viewport_height=116
window/size/borderless=true
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="GodAmp"

[file_customization]

folder_colors={
"res://Assets/": "yellow",
"res://Data/": "green",
"res://Src/": "purple"
}

[gui]

theme/custom="uid://bsacd6apsccmu"

[input]

MultipleSelection={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194325,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

2d/bg_color=Color(0.141176, 0.141176, 0.141176, 0)

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.301961, 0.301961, 0.301961, 0)
viewport/transparent_background=true
viewport/size/borderless=true
